ENVIRONMENT=local
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=realmate
POSTGRES_USER=realmate
POSTGRES_PASSWORD=realmate
POSTGRES_PORT=5432

OPENAI_API_KEY=sk-your-key-here

# Modelo local usado quando DJANGO_DEBUG=True (via Ollama).
# Fora do Docker use http://localhost:11434/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3
