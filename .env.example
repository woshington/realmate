ENVIRONMENT=local
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=realmate
POSTGRES_USER=realmate
POSTGRES_PASSWORD=realmate
POSTGRES_PORT=5432

OPENAI_API_KEY=sk-your-key-here

# Modelo usado quando DJANGO_DEBUG=True (via Ollama).
# Padrao: Ollama Cloud (https://ollama.com/v1), que EXIGE OLLAMA_API_KEY.
# Para um Ollama local, aponte a base_url e deixe a chave vazia:
#   dentro do Docker: http://host.docker.internal:11434/v1
#   fora do Docker:   http://localhost:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=
#OLLAMA_API_KEY=
